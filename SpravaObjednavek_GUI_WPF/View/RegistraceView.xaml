<UserControl x:Class="SpravaObjednavek_GUI_WPF.View.RegistraceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF.View"
             d:DesignHeight="600" d:DesignWidth="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" Padding="30" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1" Width="400" VerticalAlignment="Top" Margin="20">
            <StackPanel>
                <TextBlock Text="Nový uživatel" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <TextBlock Text="Uživatelské jméno *" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Jmeno}" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Heslo *" Foreground="Gray" Margin="0,0,0,5"/>
                <PasswordBox x:Name="HesloBox" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Role *" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding DostupneRole}" SelectedItem="{Binding VybranaRole}" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="License ID *" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding LicenseIdInput}" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Address ID *" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding AddressIdInput}" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Poznámka" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Poznamka}" Padding="5" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                <Button Content="REGISTROVAT" 
                        Command="{Binding RegistrovatCommand}"
                        CommandParameter="{Binding ElementName=HesloBox}" 
                        Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>