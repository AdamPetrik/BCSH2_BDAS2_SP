<Window x:Class="SpravaObjednavek_GUI_WPF.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF"
        xmlns:vm="clr-namespace:SpravaObjednavek_GUI_WPF.ViewModel"
        xmlns:view="clr-namespace:SpravaObjednavek_GUI_WPF.View"
        mc:Ignorable="d"
        Title="MainView" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Background" Value="#96b4e4"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                            Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2C73F7"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#2C73F7"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:KasaViewModel}">
            <view:KasaView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AlergenyViewModel}">
            <view:AlergenyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ObjednavkyViewModel}">
            <view:ObjednavkyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GalerieViewModel}">
            <view:GalerieView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StatistikyViewModel}">
            <view:StatistikyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AdministraceViewModel}">
            <view:AdministraceView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2D2D30">

            <DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                    <Separator Background="#555" Margin="0,0,0,15"/>

                    <TextBlock Text="Přihlášený uživatel:" 
                       Foreground="Gray" FontSize="12"/>

                    <TextBlock Text="{Binding PrihlasenyJmeno}" 
                       Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,2,0,5"/>

                    <Border Background="#444" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding PrihlasenyRole}" 
                           Foreground="#DDD" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="MENU" Foreground="Gray" Margin="15,0,0,10" FontWeight="Bold"/>

                    <RadioButton Content="Kasa"
                         GroupName="Navigace"
                         Style="{StaticResource MenuButtonStyle}"
                         Command="{Binding UpdateViewCommand}"
                         CommandParameter="Kasa"
                         IsChecked="True"
                         IsEnabled="{Binding JePlnyPristup}"/>

                    <RadioButton Content="Alergeny"
                         GroupName="Navigace"
                         Style="{StaticResource MenuButtonStyle}"
                         Command="{Binding UpdateViewCommand}"
                         CommandParameter="Alergeny"/>

                    <RadioButton Content="Objednávky"
                         GroupName="Navigace"
                         Style="{StaticResource MenuButtonStyle}"
                         Command="{Binding UpdateViewCommand}"
                         CommandParameter="Objednavky"
                         IsEnabled="{Binding JePlnyPristup}"/>

                    <RadioButton Content="Galerie"
                        GroupName="Navigace"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding UpdateViewCommand}"
                        CommandParameter="Galerie"/>

                    <RadioButton Content="Statistiky"
                        GroupName="Navigace"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding UpdateViewCommand}"
                        CommandParameter="Statistiky"
                        IsEnabled="{Binding JePlnyPristup}"/>

                    <RadioButton Content="Administrace"
                         GroupName="Navigace"
                         Style="{StaticResource MenuButtonStyle}"
                         Command="{Binding UpdateViewCommand}"
                         CommandParameter="Administrace"
                         IsEnabled="{Binding JePlnyPristup}"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />

    </Grid>
</Window>