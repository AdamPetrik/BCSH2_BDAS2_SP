<UserControl x:Class="SpravaObjednavek_GUI_WPF.View.SpravaUzivateluView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F0F0">
        <Border Background="White" Margin="20" CornerRadius="5" Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Správa uživatelů" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding SeznamUzivatelu}" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#DDD" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Jméno" Binding="{Binding Jmeno}" Width="150" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>

                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁 PŘIHLÁSIT SE JAKO" 
                                            Command="{Binding DataContext.EmulovatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#2196F3" Foreground="White" FontWeight="Bold" Padding="10,5" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" 
                                            ToolTip="Smazat uživatele"
                                            Command="{Binding DataContext.SmazatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#F44336" Foreground="White" FontWeight="Bold" Padding="5" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="Pozor: Po kliknutí budete přihlášeni jako vybraný uživatel a uvidíte aplikaci jeho očima." 
                           Foreground="Gray" Margin="0,20,0,0" FontStyle="Italic"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
