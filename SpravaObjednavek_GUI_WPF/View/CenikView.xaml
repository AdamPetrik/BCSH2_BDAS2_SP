<UserControl x:Class="SpravaObjednavek_GUI_WPF.View.CenikView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" Margin="20" Background="White"
                  ItemsSource="{Binding SeznamPolozek}"
                  SelectedItem="{Binding VybranaPolozka}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  BorderBrush="#DDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Název" Binding="{Binding Nazev}" Width="*"/>
                <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat={}{0:N0} Kč}" Width="80" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Margin="0,20,20,20" Background="White" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Úprava položky" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <TextBlock Text="Název" Foreground="Gray"/>
                <TextBox Text="{Binding EditNazev}" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Cena" Foreground="Gray"/>
                <TextBox Text="{Binding EditCena}" Padding="5" Margin="0,0,0,20"/>

                <Button Content="ULOŽIT ZMĚNY" Command="{Binding UlozitZmenyCommand}" 
                        Background="#FF9800" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="SMAZAT POLOŽKU" Command="{Binding SmazatPolozkuCommand}" 
                        Background="#E53935" Foreground="White" FontWeight="Bold" Padding="10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Pozn: Nelze smazat jídla, která už byla objednána." 
                           Foreground="Gray" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
