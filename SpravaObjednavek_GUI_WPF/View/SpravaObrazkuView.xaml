<UserControl x:Class="SpravaObjednavek_GUI_WPF.View.SpravaObrazkuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" Margin="20" Background="White"
                  ItemsSource="{Binding SeznamObrazku}"
                  SelectedItem="{Binding VybranyObrazek}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  BorderBrush="#DDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Soubor" Binding="{Binding NazevSouboru}" Width="*" FontWeight="Bold"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding Pripona}" Width="50"/>
                <DataGridTextColumn Header="Nahrál" Binding="{Binding Autor}" Width="80"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding NahranoKdy, StringFormat=d}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Margin="0,20,20,20" Background="White" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel Margin="10">
                <TextBlock Text="Detail Obrázku" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <Button Content="📤 NAHRÁT NOVÝ SOUBOR" Command="{Binding NahratNovyCommand}" 
                        HorizontalAlignment="Right" Margin="0,-50,0,20" Padding="10,5"/>

                <TextBlock Text="Název souboru" Foreground="Gray"/>
                <TextBox Text="{Binding EditNazev}" Padding="5" Margin="0,0,0,20"/>

                <TextBlock Text="Náhled" Foreground="Gray" Margin="0,0,0,5"/>
                <Border BorderBrush="#EEE" BorderThickness="1" Height="200" Background="#FAFAFA" Margin="0,0,0,20">
                    <Image Source="{Binding Nahled}" Stretch="Uniform"/>
                </Border>

                <Button Content="PŘEJMENOVAT" Command="{Binding UlozitCommand}" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,0,0,10"/>

                <Button Content="SMAZAT OBRÁZEK" Command="{Binding SmazatCommand}" 
                        Background="#E53935" Foreground="White" FontWeight="Bold" Padding="10"/>

                <TextBlock Text="Pozn: Nelze smazat obrázek, který je přiřazen k položce v menu." 
                           Foreground="Gray" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
