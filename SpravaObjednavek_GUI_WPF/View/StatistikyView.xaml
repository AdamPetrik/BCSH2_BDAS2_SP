<UserControl x:Class="SpravaObjednavek_GUI_WPF.View.StatistikyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <DataTemplate x:Key="GrafItemTemplate">
            <Grid Margin="10,0" VerticalAlignment="Bottom" ToolTip="{Binding Nazev}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Pocet}" 
                           HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,5"/>

                <Border Grid.Row="1" 
                        Height="{Binding VyskaSloupce}" 
                        Width="50" 
                        Background="#2196F3" 
                        CornerRadius="4,4,0,0"
                        HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="2" Text="{Binding Nazev}" 
                           Width="80" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="10" Margin="0,5,0,0" Foreground="Gray"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#F0F0F0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Statistiky prodeje" FontSize="24" FontWeight="Light" Margin="10"/>

            <Border Grid.Row="1" Background="White" Margin="10" Padding="20" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Prodej Kebabů (ks)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <Border BorderBrush="Black" BorderThickness="0,0,0,1" Height="260" Padding="0,0,0,5">
                        <ItemsControl ItemsSource="{Binding DataKebaby}" ItemTemplate="{StaticResource GrafItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" Margin="10" Padding="20" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Prodej Omáček (ks)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <Border BorderBrush="Black" BorderThickness="0,0,0,1" Height="260" Padding="0,0,0,5">
                        <ItemsControl ItemsSource="{Binding DataOmacky}" ItemTemplate="{StaticResource GrafItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>