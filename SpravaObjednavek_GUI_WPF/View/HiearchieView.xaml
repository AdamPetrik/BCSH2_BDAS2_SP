<UserControl x:Class="SpravaObjednavek_GUI_WPF.View.HiearchieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F0F0">
        <Border Background="White" Margin="20" CornerRadius="5" Padding="20">
            <StackPanel>
                <TextBlock Text="Organizační struktura (pomocí hiearchického dotazu)" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <DataGrid ItemsSource="{Binding Struktura}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Úroveň" Binding="{Binding Uroven}" Width="60"/>
                        <DataGridTextColumn Header="Stromová struktura" Binding="{Binding StromZobrazeni}" Width="200" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                        <DataGridTextColumn Header="Nadřízený" Binding="{Binding Sef}" Width="100"/>
                        <DataGridTextColumn Header="Plná cesta" Binding="{Binding Cesta}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Data jsou generována pomocí VIEW s klauzulí CONNECT BY PRIOR." 
                           Foreground="Gray" Margin="0,10,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
