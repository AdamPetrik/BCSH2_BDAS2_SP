<UserControl x:Class="SpravaObjednavek_GUI_WPF.View.AdminZpravyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F0F0F0">
        <Border Background="White" Margin="20" CornerRadius="5" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Zprávy" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding SeznamZprav}" 
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          BorderBrush="#DDD" BorderThickness="1"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Čas" Binding="{Binding Cas, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="120"/>

                        <DataGridTextColumn Header="Odesílatel" Binding="{Binding Odesilatel}" Width="150" FontWeight="SemiBold"/>

                        <DataGridTextColumn Header="Příjemce" Binding="{Binding Prijemce}" Width="150"/>

                        <DataGridTextColumn Header="Obsah zprávy" Binding="{Binding Obsah}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" 
                            ToolTip="Smazat zprávu"
                            Command="{Binding DataContext.SmazatZpravuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Foreground="Red" FontWeight="Bold" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
