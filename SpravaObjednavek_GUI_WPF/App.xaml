<Application x:Class="SpravaObjednavek_GUI_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpravaObjednavek_GUI_WPF"
             xmlns:view="clr-namespace:SpravaObjednavek_GUI_WPF.View"
             xmlns:vm="clr-namespace:SpravaObjednavek_GUI_WPF.ViewModel"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:KasaViewModel}">
            <view:KasaView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ObjednavkyViewModel}">
            <view:ObjednavkyView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AdministraceViewModel}">
            <view:AdministraceView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AlergenyViewModel}">
            <view:AlergenyView/>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Application.Resources>
</Application>
